# Local-only operation needs no API keys or .env file.
# AI_PROVIDER: Primary auditor. Supported: local, openai, anthropic, gemini, grok.
AI_PROVIDER="local"

# AI_FALLBACK_PROVIDER: Optional. Blank/unset disables fallback.
# External fallback is only attempted when explicitly configured and primary fails.
# Using the same provider as the primary disables redundant fallback.
AI_FALLBACK_PROVIDER=""

# External keys are optional; set only for an explicitly selected provider/fallback.
# OPENAI_API_KEY: Required only when selecting openai.
OPENAI_API_KEY=""

# OPENAI_MODEL: Optional model override for OpenAI provider.
OPENAI_MODEL="gpt-6-luna"

# ANTHROPIC_API_KEY: Required only when selecting anthropic.
ANTHROPIC_API_KEY=""

# ANTHROPIC_MODEL: Optional model override for Anthropic provider.
ANTHROPIC_MODEL="claude-sonnet-5-5"

# GEMINI_API_KEY: Required only when selecting gemini.
GEMINI_API_KEY=""

# GEMINI_MODEL: Optional model override for Gemini provider.
GEMINI_MODEL="gemini-3.8-flash"

# XAI_API_KEY: Required only when selecting grok.
XAI_API_KEY=""

# GROK_MODEL: Optional model override for Grok provider.
GROK_MODEL="grok-4.7"

# AI_PROVIDER_TIMEOUT_MS: Per-attempt timeout for provider calls (milliseconds).
AI_PROVIDER_TIMEOUT_MS="15000"

# AI_PROVIDER_RETRIES: Number of retry attempts per provider for transient failures.
AI_PROVIDER_RETRIES="1"

# PORT: Port for the Express API server (default: 3001).
PORT="3001"
